{% extends 'base.html.twig' %}

{% block title %}Demo{% endblock %}

{% block body %}
<h1>Liste du matériel(Démo)</h1>
<table>
  <thead>
    <tr>
      <th scope="col">Id</th>
      <th scope="col">Nom</th>
      <th scope="col">Catégorie</th>
      <th scope="col">Status</th>
      <th scope="col">Prix</th>
    </tr>
  </thead>
  <tbody>
    {% set color = {
    'disponible': 'status-green',
    'attribué': 'status-blue',
    'maintenance': 'status-orange'
} %} 
{% for m in materials %}
 <tr>
      <td scope="row">{{ m.id }}</td>
      <td scope="row">{{ m.name }}</td>
      <td scope="row">{{ m.category }}</td>
      <td class="{{ color[m.status]|default('status-gray') }}">
            {{ m.status }}
      </td>
 <th scope="row">{{ m.purchasePrice }}</th>
</tr>
{% endfor %}
  </tbody>
</table>
{% endblock %}
