{% extends 'base.html.twig' %}

{% block title %}Statistiques des matériels{% endblock %}

{% block body %}
<div>
    <h1>Statistiques des matériels</h1>
    <table>
  <thead>
    <tr>
      <th scope="col">Status</th>
      <th scope="col">Nombre</th>
    </tr>
  </thead>
  <tbody>
  {% for item in statistiques %}
    <tr>
        <td>{{ item.status }}</td>
        <td>{{ item.total }}</td>
    </tr>
{% else %}
    <tr>
        <td colspan="2">Aucune statistique disponible.</td>
    </tr>
{% endfor %}
    </tr>
  </tbody>
</table>
</div>
{% endblock %}
